{
  "name": "@dms/server",
  "private": true,
  "version": "0.42.1",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/index.js --sourcemap",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.3.2",
    "nodemailer": "^10.0.13",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^6.4.17",
    "esbuild": "^0.25.3",
    "tsx": "^4.19.4"
  }
}
